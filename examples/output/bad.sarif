        {
          "ruleId": "country-unknown",
          "ruleIndex": 12,
          "level": "error",
          "message": {
            "text": "The country of holder 0xcccccccccccccccccccccccccccccccccccccccc is \"TW\", which is not a two-letter code of the country table the tool reads. The UN table the tool reads lists no code for Taiwan; check the code by hand. Fix: Write the two capital letters of the country, such as GB for the United Kingdom."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/register.csv",
                  "index": 1
                },
                "region": {
                  "startLine": 12,
                  "startColumn": 44
                }
              }
            }
          ],
          "properties": {
            "kind": "documented",
            "input": "register",
            "subject": "0xcccccccccccccccccccccccccccccccccccccccc"
          }
        },
        {
          "ruleId": "address-malformed",
          "ruleIndex": 13,
          "level": "error",
          "message": {
            "text": "The address of holder 0x1234 has 4 characters after 0x, not 40; an address is 0x followed by 40 hex digits. Fix: Copy the address again from the wallet, as 0x and 40 hex digits."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/register.csv",
                  "index": 1
                },
                "region": {
                  "startLine": 13,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "kind": "documented",
            "input": "register",
            "subject": "0x1234"
          }
        },
        {
          "ruleId": "field-invalid",
          "ruleIndex": 3,
          "level": "error",
          "message": {
            "text": "The investorClass of holder 0x1234 is \"founders\", which is not a class of the configuration (reg-d and reg-s). Fix: Write the value as docs/inputs.md shows: text for names, codes and addresses, whole numbers for decimals, days and limits, plain decimal numbers for amounts, true or false for the controls."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/register.csv",
                  "index": 1
                },
                "region": {
                  "startLine": 13,
                  "startColumn": 11
                }
              }
            }
          ],
          "properties": {
            "kind": "input",
            "input": "register",
            "subject": "0x1234"
          }
        },
        {
          "ruleId": "field-missing",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "Holder 0xdddddddddddddddddddddddddddddddddddddddd has no acquiredDay, but its class reg-s has a lock-up of 40 days, so a transfer from it cannot be checked. Fix: Add the field named; docs/inputs.md lists what each file needs."
          },
          "locations": [
            {
