          }
        },
        {
          "ruleId": "investor-claims-missing",
          "ruleIndex": 17,
          "level": "error",
          "message": {
            "text": "Holder 0x5555555555555555555555555555555555555555 holds 8000 tokens, but its identity lacks the required claim ACCREDITATION, so the identity registry does not verify it and it cannot receive more. Fix: Register the investor and have a trusted issuer add the missing claims before the transfer, or leave the transfer out; review a holder who lacks a claim with the issuer."
          },
          "locations": [
